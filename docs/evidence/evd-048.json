  "archive": {
    "format": "xz-compressed tar in ordered base64 chunks",
    "sha256": "7f9b3df998a73af6e6c8720a11c311ba14596eccaf17a99b640e7974ba599b02",
    "parts": [
      "evd-048-raw-01.json",
      "evd-048-raw-02.json"
    ],
    "files": 99,
    "restore_python_from_repository_root": [
      "from pathlib import Path",
      "import json, base64, hashlib, tarfile, io",
      "d=Path('docs/evidence'); j=json.loads((d/'evd-048.json').read_bytes()); a=j['archive']",
      "b=b''.join(base64.b64decode(json.loads((d/p).read_bytes())['base64']) for p in a['parts'])",
      "assert hashlib.sha256(b).hexdigest()==a['sha256']",
      "with tarfile.open(fileobj=io.BytesIO(b),mode='r:xz') as t: t.extractall('edf48-restored',filter='data')",
      "p=Path('edf48-restored'); m=(p/'MANIFEST.sha256').read_bytes(); assert hashlib.sha256(m).hexdigest()==j['manifest_sha256']",
      "for line in m.decode().splitlines():",
      "    h,n=line.split('  ./',1); assert hashlib.sha256((p/n).read_bytes()).hexdigest()==h"
    ],
    "offline_replay": "In a disposable restored copy run python -B verify.py and python -B cross.py. For controls.rs place the frozen checkout at ../edf48-src and use rustc +1.95.0 --edition 2024 --cfg jnox_ordinary_deadline -Awarnings controls.rs, then execute controls. Offline replay uses stored symbols and disassembly."
