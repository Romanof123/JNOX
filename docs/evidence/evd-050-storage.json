    ],
    "restore_python": [
      "from pathlib import Path",
      "import json, hashlib, base64",
      "d=Path('docs/evidence')",
      "j=json.loads((d/'evd-050-storage.json').read_bytes())",
      "a=j['archive']; data=b''.join(base64.b64decode(json.loads((d/f).read_bytes())['base64']) for f in a['parts'])",
      "assert hashlib.sha256(data).hexdigest()==a['sha256']",
      "Path('storage-evidence.tar.gz').write_bytes(data)"
    ],
    "restore_shell": [
      "mkdir storage-restored",
      "tar -xzf storage-evidence.tar.gz -C storage-restored",
      "cd storage-restored/storage-crossover-fresh",
      "sha256sum -c SHA256SUMS"
    ]
