  "restore_python": "from pathlib import Path\nimport base64,hashlib,io,tarfile,json\na=json.loads(Path('evd-042-v2.json').read_bytes())['archive']; parts=[]\nfor name in a['parts']:\n    o=json.loads(Path(name).read_bytes()); b=base64.b64decode(o['data'],validate=True); assert hashlib.sha256(b).hexdigest()==o['sha256']; parts.append(b)\nb=b''.join(parts); assert hashlib.sha256(b).hexdigest()==a['sha256']\nwith tarfile.open(fileobj=io.BytesIO(b),mode='r:gz') as t:\n    for name,digest in json.load(t.extractfile('archive-file-digests.json')).items():\n        p=Path('v2')/name; assert p.resolve().is_relative_to(Path('v2').resolve()); v=t.extractfile(name).read()\n        assert hashlib.sha256(v).hexdigest()==digest; p.parent.mkdir(parents=True,exist_ok=True); p.write_bytes(v)",
